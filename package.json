{
  "name": "happy-locale",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@11.21.0",
  "license": "MIT",
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "scripts": {
    "build": "nuxt build",
    "build:static": "pnpm generate:public && pnpm verify:static",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "generate:public": "NUXT_PUBLIC_TRANSLATION_ENDPOINT_ENABLED=false nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "eslint . --fix",
    "format:check": "eslint .",
    "typecheck": "nuxt typecheck && vue-tsc -p tests/tsconfig.json --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:watch": "vitest",
    "verify:static": "node scripts/verify-static-output.mjs"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "@pinia/nuxt": "^1.0.2",
    "@tesseract.js-data/eng": "^1.0.0",
    "nuxt": "^4.5.2",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.3.289",
    "pinia": "^4.0.3",
    "tesseract.js": "^7.0.0",
    "tesseract.js-core": "^7.0.0",
    "vue": "^3.5.42"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.5.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.13.4",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vue/test-utils": "^2.5.0",
    "eslint": "^10.10.0",
    "happy-dom": "^20.14.5",
    "typescript": "^5.9.3",
    "vitest": "^5.0.0",
    "vue-tsc": "^3.3.11"
  }
}
