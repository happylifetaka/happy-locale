{
  "name": "happy-locale",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@11.21.0",
  "license": "MIT",
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "scripts": {
    "build": "nuxt build",
    "build:static": "pnpm generate:public && pnpm verify:static",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "generate:public": "NUXT_PUBLIC_TRANSLATION_ENDPOINT_ENABLED=false nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "eslint . --fix",
    "format:check": "eslint .",
    "typecheck": "nuxt typecheck && tsc -p tests/tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify:static": "node scripts/verify-static-output.mjs"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "@pinia/nuxt": "^1.0.2",
    "@tesseract.js-data/eng": "^1.0.0",
    "nuxt": "^4.5.2",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.2.108",
    "pinia": "^4.0.3",
    "tesseract.js": "^7.0.0",
    "tesseract.js-core": "^7.0.0",
    "vue": "^3.5.18"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.3.0",
    "@vue/test-utils": "^2.4.6",
    "eslint": "^10.4.0",
    "typescript": "^5.9.2",
    "vitest": "^4.1.11",
    "vue-tsc": "^3.0.5"
  }
}
